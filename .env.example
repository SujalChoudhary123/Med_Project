# Copy this file to ".env" on the server and fill it in. NEVER commit ".env".

# Your website address, without https:// (DNS must already point to this server).
DOMAIN=pharmacy.example.com

# Gmail account that sends the OTP emails, and its 16-character APP PASSWORD
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_EMAIL=your-address@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Google sign-in web client ID (same value as VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Who can open the Admin page (all shops, renewals). Sign up with this address
# BEFORE going live. Comma separated if there is more than one.
ADMIN_EMAILS=you@example.com

# Shown to customers on the landing, Plan and Help pages.
SUPPORT_PHONE=+919000000000
SUPPORT_EMAIL=support@example.com

# MedTrack is FREE for everyone while PAID_START is empty. To start charging later,
# set the first paid day here (YYYY-MM-DD), at least 30 days ahead, and fill in the
# settings below. See "Starting to charge" in DEPLOY.md.
PAID_START=

# Used only once charging starts. Payments are confirmed by hand on the Admin page.
PAY_UPI_ID=
PAY_NOTE=
PLAN_PRICE_MONTHLY=499
PLAN_PRICE_YEARLY=4999
TRIAL_DAYS=14
GRACE_DAYS=3

# Optional
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
