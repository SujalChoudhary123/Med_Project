# Settings for running the API on your own Windows PC with run-local.ps1.
# Copy to "server.env" and fill in. NEVER share or commit server.env.

SMTP_EMAIL=your-address@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Who can open the Admin page (your own sign-in email).
ADMIN_EMAILS=you@example.com

# Optional
# PORT=8080
# ALLOWED_ORIGINS=http://localhost:5173
# BACKUP_KEEP=14
