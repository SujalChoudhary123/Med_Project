# Copy to .env for local development (Vite loads it automatically).

# Google sign-in client ID (public value, safe to expose to the browser).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Where the Java API runs. Leave unset for local dev (http://localhost:8080).
# VITE_API_URL=http://localhost:8080
